# VisionForge local configuration.
# Copy to .env and adjust. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------- application
ENVIRONMENT=local          # local | ci | staging | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
APP_NAME=visionforge-api

# ---------------------------------------------------------------- database
# Host port 5442, not 5432: ports 5432 and 5433 are already taken on this
# machine by unrelated projects. See docs/adr/0001-local-ports.md.
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=visionforge
POSTGRES_DB=visionforge
POSTGRES_PORT=5442
DATABASE_URL=postgresql+psycopg://visionforge:visionforge@localhost:5442/visionforge

# ---------------------------------------------------------------- redis
# Host port 6389, not 6379: a native redis-server already holds 6379.
REDIS_PORT=6389
REDIS_URL=redis://localhost:6389/0

# ---------------------------------------------------------------- object storage
# MinIO locally; on AWS leave S3_ENDPOINT_URL empty and use an IAM role.
MINIO_ROOT_USER=visionforge
MINIO_ROOT_PASSWORD=visionforge-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=visionforge
S3_SECRET_KEY=visionforge-dev-secret
S3_BUCKET_MEDIA=visionforge-media
S3_BUCKET_DERIVATIVES=visionforge-derivatives
S3_BUCKET_RENDERS=visionforge-renders

# ---------------------------------------------------------------- http
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---------------------------------------------------------------- ai caches
# Phase 0 decision: model weights live OUTSIDE the repository so they are never
# committed and never enter a Docker build context. Not used until Phase 3.
# HF_HOME=E:\ml-cache\huggingface
# TORCH_HOME=E:\ml-cache\torch
