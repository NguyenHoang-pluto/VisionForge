# VisionForge local configuration.
# Copy to .env and adjust. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------- application
ENVIRONMENT=local          # local | ci | staging | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
APP_NAME=visionforge-api

# ---------------------------------------------------------------- database
# Host port 5442, not 5432: ports 5432 and 5433 are already taken on this
# machine by unrelated projects. See docs/adr/0001-local-ports.md.
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=visionforge
POSTGRES_DB=visionforge
POSTGRES_PORT=5442
DATABASE_URL=postgresql+psycopg://visionforge:visionforge@localhost:5442/visionforge

# ---------------------------------------------------------------- redis
# Host port 6389, not 6379: a native redis-server already holds 6379.
REDIS_PORT=6389
REDIS_URL=redis://localhost:6389/0

# ---------------------------------------------------------------- object storage
# MinIO locally; on AWS leave S3_ENDPOINT_URL empty and use an IAM role.
MINIO_ROOT_USER=visionforge
MINIO_ROOT_PASSWORD=visionforge-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=visionforge
S3_SECRET_KEY=visionforge-dev-secret
S3_BUCKET_MEDIA=visionforge-media
S3_BUCKET_DERIVATIVES=visionforge-derivatives
S3_BUCKET_RENDERS=visionforge-renders

# ---------------------------------------------------------------- http
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true              # auto-reload the API on code changes (local only)
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=0.1.0

# ---------------------------------------------------------------- ffmpeg
# FFmpeg and ffprobe must be on PATH. Workers assert this at start-up and refuse
# to accept jobs they cannot process. Install per the README; this project was
# developed against 9.0.1.
# PATH must include, e.g., E:fmpegin

# ---------------------------------------------------------------- ai caches
# Phase 0 decision: model weights live OUTSIDE the repository so they are never
# committed and never enter a Docker build context. Not used until Phase 3.
# HF_HOME=E:\ml-cache\huggingface
# TORCH_HOME=E:\ml-cache\torch

# ---------------------------------------------------------------- llm planner
# Off by default. With AI disabled, VisionForge plans every edit with the
# deterministic rules engine and works completely -- AI is an addition, never a
# dependency, and no code path requires a provider to be present.
LLM_ENABLED=false

# anthropic | openai | stub
#   stub is a deterministic LOCAL provider with no model and no network. It
#   exists so the whole LLM path can be exercised in tests and locally without a
#   key. It is refused outright when ENVIRONMENT=production.
LLM_PROVIDER=anthropic

# Empty means the provider's own default (claude-sonnet-5 / gpt-4o-mini).
LLM_MODEL=

# Empty means the provider's public endpoint. Override to point at a compatible
# gateway or a locally-hosted model without changing any code.
LLM_BASE_URL=

# SERVER-SIDE ONLY. Read by the provider adapters and nowhere else: never
# returned by an endpoint, never logged, never written to a plan or a database
# row, never sent to the browser. Leave empty to keep AI planning off.
#
# NEVER COMMIT A REAL KEY. This file is the example; .env is git-ignored.
LLM_API_KEY=

# Hard ceiling on one planning call. Shorter than a user will wait: past this
# the rules engine is a better answer than a slower one.
LLM_TIMEOUT_S=30
LLM_MAX_OUTPUT_TOKENS=2000

# Phase 12: set true where the render worker has an NVIDIA GPU (NVENC). Enables 8K.
RENDER_GPU=false
