# ---------- Media & generated artifacts ----------
# Uploaded media, derivatives and renders live in object storage, not in git.
media/
uploads/
renders/
derivatives/
proxies/
thumbnails/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.flac
# Test media fixtures are GENERATED by FFmpeg on first run (see
# tests/integration/conftest.py), not committed: a few binary files in git is a
# repository that grows forever, and generation is deterministic.
apps/api/tests/integration/fixtures/

