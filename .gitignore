*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Acceptance-test media. Every clip under here is generated by the e2e scripts
# with FFmpeg on demand -- committing them would put binaries in the history
# that the scripts can rebuild in seconds.
scripts/.e2e-clips/
